# ---- data lake: large / regenerable / sensitive
data/bronze/**/attachments/
# ...also when it is a symlink to external storage (the Jetson keeps attachments on its USB drive)
data/bronze/**/attachments
data/bronze/**/raw/
data/bronze/**/raw
data/bronze/**/*.log
# SAM.gov records are ~300 MB and rebuilt daily from SAM's public extract
data/bronze/sam/SAM_Data.json
# DIBBS records grow ~45 MB a month; rebuilt from DLA's daily RFQ files
data/bronze/dibbs/DIBBS_Data.json
# temp files of atomic saves, and stray copies of SAM's extract
data/bronze/**/*.saving
data/bronze/**/*.part
data/bronze/sam/extract/
data/silver/
# award history reference db (derived from USAspending downloads; on the Jetson a symlink to the USB drive)
data/reference/usaspending
bidintel/data/

# ---- secrets & browser state (scrapers keep credentials in a local .env)
.env
**/.chrome_profile/

# ---- databases, archives, caches
*.db
*.db-wal
*.db-shm
*.zip
__pycache__/
*.py[cod]
*.log
attachments/
caleprocure_businesses_10_15.xls

# local Python environment
.venv/
